# Copy these keys into Vercel → Project → Settings → Environment Variables.
# Real values live in .env.local (gitignored), never committed here.

# --- Client-side (Vite, exposed to the browser — VITE_ prefix required) ---
VITE_GA4_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_RECAPTCHA_SITE_KEY=

# --- Server-side only (read by api/calendly-webhook.js, never exposed to
#     the browser — do NOT prefix these with VITE_). See README-calendly.md
#     for how to get each of these values. ---
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_ORGANIZATION_URI=
CALENDLY_BRONZE_EVENT_TYPE_URI=
CALENDLY_SILVER_EVENT_TYPE_URI=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
SAM_NOTIFICATION_EMAIL=
